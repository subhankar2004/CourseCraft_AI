{
  "name": "coursecraft-ai",
  "version": "0.0.0",
  "private": true,
  "description": "AI-integrated LMS that turns YouTube videos into structured courses with study notes and a course-aware RAG chatbot.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "lint:js": "pnpm -r --if-present lint",
    "lint": "pnpm lint:js && pnpm ai:lint",
    "typecheck:js": "pnpm -r --if-present typecheck",
    "typecheck": "pnpm typecheck:js && pnpm ai:typecheck",
    "test:js": "pnpm -r --if-present test",
    "test": "pnpm test:js && pnpm ai:test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d --wait",
    "infra:up:ollama": "docker compose --profile ollama up -d --wait",
    "infra:down": "docker compose --profile ollama down",
    "infra:reset": "docker compose --profile ollama down -v",
    "infra:ps": "docker compose --profile ollama ps",
    "infra:logs": "docker compose --profile ollama logs -f",
    "ai:sync": "uv --directory services/ai sync",
    "ai:dev": "uv --directory services/ai run uvicorn app.main:app --reload --port 8000",
    "ai:fixtures": "uv --directory services/ai run python -m scripts.record_fixtures",
    "ai:notes-sample": "uv --directory services/ai run python -m scripts.generate_notes",
    "ai:lint": "uv --directory services/ai run ruff check . && uv --directory services/ai run ruff format --check .",
    "ai:format": "uv --directory services/ai run ruff format . && uv --directory services/ai run ruff check --fix .",
    "ai:typecheck": "uv --directory services/ai run mypy app tests scripts",
    "ai:test": "uv --directory services/ai run pytest"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
