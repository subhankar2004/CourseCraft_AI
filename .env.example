# CourseCraft AI — environment template
# Copy to `.env` in the repo root:  cp .env.example .env
# `.env` is git-ignored. Never commit real keys. Rotate any key that leaks.
# Values marked (secret) must be filled per developer / per environment.

# ─── General ────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Local infrastructure (docker-compose.yml) ──────────────────────────────
POSTGRES_USER=coursecraft
POSTGRES_PASSWORD=coursecraft
POSTGRES_DB=coursecraft
POSTGRES_PORT=5432
REDIS_PORT=6379
OLLAMA_PORT=11434

# ─── API (apps/api) ─────────────────────────────────────────────────────────
API_PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
DATABASE_URL=postgresql://coursecraft:coursecraft@localhost:5432/coursecraft
# Used by automated tests only (database created by docker/postgres/init).
TEST_DATABASE_URL=postgresql://coursecraft:coursecraft@localhost:5432/coursecraft_test
REDIS_URL=redis://localhost:6379
# (secret) Generate with: openssl rand -base64 48
JWT_SECRET=change-me
# Session lifetime: a number + s|m|h|d (sets both the JWT expiry and the cookie max-age).
JWT_EXPIRES_IN=7d
# Browser origin allowed by CORS.
WEB_ORIGIN=http://localhost:3000
# Express "trust proxy": false locally. In production behind Caddy, set the proxy hop count (1),
# so rate limiting sees real client IPs. Never enable without a proxy (clients could spoof IPs).
TRUST_PROXY=false
AI_SERVICE_URL=http://localhost:8000
# (secret) Shared key the API sends as X-Internal-Key to the AI service.
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=change-me
# Shared by the API and the AI service: the most videos one course can be generated from.
MAX_VIDEOS_PER_COURSE=25

# ─── Demo seed (pnpm --filter api prisma:seed) ──────────────────────────────
# Local/demo accounts only. Passwords: at least 12 characters, e.g. openssl rand -base64 18
# The seed refuses to run when NODE_ENV=production unless SEED_ALLOW_PRODUCTION=true.
SEED_ADMIN_EMAIL=admin@coursecraft.local
# (secret)
SEED_ADMIN_PASSWORD=
SEED_STUDENT_EMAIL=student@coursecraft.local
# (secret)
SEED_STUDENT_PASSWORD=

# ─── AI service (services/ai) ───────────────────────────────────────────────
AI_PORT=8000
# openai | ollama
LLM_PROVIDER=openai
# (secret) https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
# (secret) https://app.pinecone.io -> API Keys
PINECONE_API_KEY=
# One index per embedding model/dimension (SPEC §6). The name must end with the model's suffix:
#   text-embedding-3-small → -te3s · text-embedding-3-large → -te3l · nomic-embed-text → -nomic
# The AI service refuses to start on a mismatch (e.g. LLM_PROVIDER=ollama with a -te3s index).
PINECONE_INDEX=coursecraft-te3s
# Per-request limits for model calls.
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
# Speech-to-text fallback (faster-whisper, runs locally on CPU; model downloaded on first use).
# tiny | base | small | medium: larger is more accurate but slower.
WHISPER_MODEL=base
WHISPER_ENABLED=true
# Videos longer than this are not transcribed (their captions are used, or ingestion fails).
WHISPER_MAX_MINUTES=90
# Transcript chunking: tokens per chunk (cl100k_base) and tokens repeated between neighbours.
CHUNK_TARGET_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
RAG_TOP_K=6
RAG_MIN_SCORE=0.35
# Cognitive Load Index threshold (0-100) above which notes are simplified.
CLI_MAX=60

# ─── Storage (production; optional locally) ─────────────────────────────────
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
CDN_BASE_URL=
# Locally prefer an AWS CLI profile (AWS_PROFILE) over static keys.
# In production use an IAM role; never use root account keys.
AWS_PROFILE=

# ─── Web (apps/web) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Public origin of the web app: used for absolute links in Open Graph / sharing metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
